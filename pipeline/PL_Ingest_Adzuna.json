{
	"name": "PL_Ingest_Adzuna",
	"properties": {
		"activities": [
			{
				"name": "Get_Cities_And_Codes",
				"type": "Lookup",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT DISTINCT e.City, m.CountryCode \nFROM stg_education_costs e\nJOIN DimCountryMapping m ON e.Country = m.CountryName\nWHERE e.City IS NOT NULL \n  AND m.IsSupportedByAdzuna = 1;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_StgEducationCosts",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Get_Cities_And_Codes",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get_Cities_And_Codes').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Fetch_Adzuna_JSON",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 3,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET",
										"additionalHeaders": "Accept: application/json\nContent-Type: application/json\nUser-Agent: python-requests/2.28.1",
										"requestTimeout": ""
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobStorageWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_Http_Adzuna",
									"type": "DatasetReference",
									"parameters": {
										"RelativeUrlPath": {
											"value": "@concat('https://api.adzuna.com/v1/api/jobs/', trim(item().CountryCode), '/search/1?app_id=', trim(pipeline().parameters.AdzunaAppId), '&app_key=', trim(pipeline().parameters.AdzunaAppKey), '&results_per_page=50&where=', uriComponent(trim(item().City)), '&what=data')",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_Blob_RawJobs",
									"type": "DatasetReference",
									"parameters": {
										"FileName": {
											"value": "@concat(item().CountryCode, '_', item().City, '_raw.json')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "Load_to_STG",
				"type": "Copy",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "ForEach1",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"additionalColumns": [
							{
								"name": "NazwaPliku",
								"value": "$$FILEPATH"
							},
							{
								"name": "DataLadowania",
								"value": {
									"value": "@utcnow()",
									"type": "Expression"
								}
							}
						],
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"wildcardFolderPath": "jobs",
							"wildcardFileName": "*",
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": "TRUNCATE TABLE stg_job_postings",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "Prop_0"
								},
								"sink": {
									"name": "RawJsonData",
									"type": "String"
								}
							},
							{
								"source": {
									"name": "NazwaPliku"
								},
								"sink": {
									"name": "SourceFileName",
									"type": "String"
								}
							},
							{
								"source": {
									"name": "DataLadowania"
								},
								"sink": {
									"name": "LoadDate",
									"type": "DateTime"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_Blob_RawText",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_SQL_StgJobPostings",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Exec_Parse_JSON",
				"type": "SqlServerStoredProcedure",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Load_to_STG",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_01_Parse_JSON_To_Staging]"
				},
				"linkedServiceName": {
					"referenceName": "LS_SQL_EnjoyersDatabase",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Exec_Load_Fact",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Exec_Parse_JSON",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_99_Load_FactJobPostings]"
				},
				"linkedServiceName": {
					"referenceName": "LS_SQL_EnjoyersDatabase",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"AdzunaAppId": {
				"type": "string",
				"defaultValue": "b2486541"
			},
			"AdzunaAppKey": {
				"type": "string",
				"defaultValue": "d63e05cde4a5e6f64ad24471d2461a4f"
			}
		},
		"annotations": []
	}
}